//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  RANGE REVERSION — Platform Giants (AMZN, GOOGL)
//
//  Bucket thesis (July 2026):
//  AMZN and GOOGL are event-driven platforms: they coil in wide ranges while
//  the market digests an overhang (antitrust rulings for GOOGL, the $200B
//  capex / free-cash-flow debate for AMZN), then re-rate in a step function
//  when the fog lifts. Between those steps, price oscillates around value.
//  AMZN is +~6% YTD and chopping; GOOGL trends via discrete re-rates with
//  fadeable overshoots in between. The edge in this bucket is buying panic at
//  the lower volatility band when the LONG-TERM trend is still up, and selling
//  the snap-back to the mean — not riding breakouts (they routinely stall into
//  the next headline).
//
//  Logic:
//    1. Structural filter : price above the 200-day SMA — only fade dips in
//                           names whose big-picture trend is intact.
//    2. Setup             : close below the lower Bollinger Band (20, 2.0)
//                           AND fast RSI(3) < 20 — a statistical washout.
//    3. Exit (target)     : close back above the 20-day basis — the snap-back
//                           is the trade; don't overstay.
//    4. Exit (time stop)  : if the bounce hasn't come in 10 bars, the thesis
//                           is stale — exit flat.
//    5. Exit (disaster)   : entry − 3 × ATR(14) hard stop for the scenario
//                           where a "dip" is actually a re-rating DOWN
//                           (adverse antitrust ruling, guidance cut).
//
//  Designed for the DAILY timeframe. Long-only by design.
// ─────────────────────────────────────────────────────────────────────────────
strategy("Range Reversion [AMZN/GOOGL]",
     shorttitle="PRR",
     overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=50,
     commission_type=strategy.commission.percent,
     commission_value=0.03,
     slippage=2,
     pyramiding=0,
     process_orders_on_close=true)

// ───────────────────────────── Backtest window ──────────────────────────────
grpW = "Backtest Window"
i_useWindow  = input.bool(true, "Limit backtest to recent window", group=grpW,
     tooltip="Restricts entries to the last N calendar days so the stats reflect the current range-bound, headline-driven regime rather than 2023–2025 trend conditions.")
i_windowDays = input.int(365, "Window length (calendar days)", minval=30, maxval=1825, group=grpW)
inWindow = not i_useWindow or time >= timenow - i_windowDays * 86400000

// ───────────────────────────── Structural filter ────────────────────────────
grpT = "Structural Trend Filter"
i_useTrendFilter = input.bool(true, "Only fade dips above long-term SMA", group=grpT,
     tooltip="Mean reversion against a broken long-term trend is how reversion accounts die. Keep this on.")
i_trendLen       = input.int(200, "Long-term SMA", minval=100, maxval=300, group=grpT)

smaTrend = ta.sma(close, i_trendLen)
trendOk  = not i_useTrendFilter or close > smaTrend

// ───────────────────────────── Washout entry ────────────────────────────────
grpE = "Washout Entry"
i_bbLen   = input.int(20, "Bollinger length", minval=10, maxval=50, group=grpE)
i_bbMult  = input.float(2.0, "Bollinger std-dev multiple", minval=1.0, maxval=3.0, step=0.1, group=grpE,
     tooltip="2.0 = classic bands. Raise to 2.5 to demand deeper washouts (fewer, higher-quality entries).")
i_rsiLen  = input.int(3, "Fast RSI length", minval=2, maxval=10, group=grpE,
     tooltip="Short-lookback RSI is the standard oversold trigger for swing reversion — RSI(14) barely reaches oversold on these names.")
i_rsiOS   = input.float(20.0, "Fast RSI oversold level", minval=5, maxval=40, step=1, group=grpE)

basis = ta.sma(close, i_bbLen)
dev   = i_bbMult * ta.stdev(close, i_bbLen)
lowerBand = basis - dev
upperBand = basis + dev

fastRsi = ta.rsi(close, i_rsiLen)
washout = close < lowerBand and fastRsi < i_rsiOS
longSignal = washout and trendOk

// ───────────────────────────── Exits ────────────────────────────────────────
grpX = "Exits"
i_exitAtBasis = input.bool(true, "Exit at Bollinger basis (mean)", group=grpX,
     tooltip="The snap-back to the 20-day mean IS the trade. Turning this off and exiting at the upper band is greedier — it wins bigger in ranges but gives back more when the range breaks down.")
i_useTimeStop = input.bool(true, "Use time stop", group=grpX)
i_maxBars     = input.int(10, "Max bars in trade", minval=3, maxval=30, group=grpX,
     tooltip="If the bounce hasn't happened in ~2 weeks, the washout thesis is stale.")
i_atrLen      = input.int(14, "ATR length", minval=5, maxval=30, group=grpX)
i_stopAtr     = input.float(3.0, "Disaster stop (ATR multiple)", minval=1.5, maxval=5.0, step=0.25, group=grpX,
     tooltip="Deliberately wide — reversion entries are early by construction. This stop exists for genuine re-ratings down (antitrust shock, guidance cut), not normal noise.")

atr = ta.atr(i_atrLen)

var float entryStop = na

if longSignal and strategy.position_size == 0 and inWindow
    strategy.entry("Long", strategy.long)
    entryStop := close - i_stopAtr * atr

if strategy.position_size > 0
    strategy.exit("Disaster", from_entry="Long", stop=entryStop)
    targetHit = i_exitAtBasis ? close > basis : close > upperBand
    if targetHit
        strategy.close("Long", comment="Mean tagged")
    barsHeld = bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1)
    if i_useTimeStop and barsHeld >= i_maxBars
        strategy.close("Long", comment="Time stop")
else
    entryStop := na

// ───────────────────────────── Display ──────────────────────────────────────
grpD = "Display"
i_showBg = input.bool(true, "Shade background when structurally bullish", group=grpD)

plot(basis, "BB basis", color=color.new(color.aqua, 20))
pU = plot(upperBand, "BB upper", color=color.new(color.gray, 60))
pL = plot(lowerBand, "BB lower", color=color.new(color.gray, 60))
fill(pU, pL, color=color.new(color.aqua, 96))
plot(smaTrend, "Trend SMA", color=color.new(color.orange, 0), linewidth=2)
plot(strategy.position_size > 0 ? entryStop : na, "Disaster stop", color=color.red, style=plot.style_linebr)
plotshape(longSignal and strategy.position_size == 0 and inWindow, "Washout entry",
     style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small)
bgcolor(i_showBg and trendOk ? color.new(color.teal, 96) : na)
bgcolor(not inWindow ? color.new(color.gray, 90) : na)
